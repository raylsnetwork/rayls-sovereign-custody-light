{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (web)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Rayls.Custody.HSM.API/bin/Debug/net8.0/Rayls.Custody.HSM.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Rayls.Custody.HSM.API",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "LOC",
                "POSTGRESQL_SERVER": "localhost",
                "POSTGRESQL_USERNAME": "postgres",
                "POSTGRESQL_PORT": "5432",
                "POSTGRESQL_PASSWORD": "dev-only-password",
                "POSTGRESQL_DBNAME": "raylzdb",
                "AUTH_API_KEY": "dev-only-api-key",
                "AUTH_JWT_SECRET": "dev-only-jwt-signing-secret-change-me",
                "EVM_JSON_RPC": "http://localhost:8545",
                "EVM_JSON_RPC_CHAIN_ID": "1337"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}