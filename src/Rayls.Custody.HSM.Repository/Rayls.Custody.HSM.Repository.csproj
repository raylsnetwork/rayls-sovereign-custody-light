<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Rayls.Custody.HSM.Repository</RootNamespace>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <!-- Suppress conflict between Nethereum (<8.0.0) and EF Core (>=8.0.2) -->
    <NoWarn>$(NoWarn);NU1107</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Force version to satisfy EF Core >=8.0.2; Nethereum works fine with 8.x at runtime -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Datadog.Monitoring.Distribution" Version="2.0.1-beta01" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rayls.Custody.HSM.Service\Rayls.Custody.HSM.Service.csproj" />
  </ItemGroup>

</Project>
