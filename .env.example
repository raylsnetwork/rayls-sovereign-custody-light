# Copy this file to .env and fill in your own values. Do not commit .env.
# The values below are non-secret local-development placeholders.

# PostgreSQL
POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=dev-only-password
POSTGRESQL_DBNAME=raylzdb

# Auth
AUTH_API_KEY=dev-only-api-key
# AUTH_JWT_SECRET must be at least 32 bytes for HS256.
AUTH_JWT_SECRET=dev-only-jwt-signing-secret-change-me

# EVM
EVM_JSON_RPC_CHAIN_ID=1337
EVM_JSON_RPC=http://localhost:8545

# Wallets
KMS_MAX_WALLETS=200
KEYSTORE_MAX_WALLETS=20
